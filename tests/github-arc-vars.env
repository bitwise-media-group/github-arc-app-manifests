# The github-arc-vars ConfigMap both modules publish (modules/{aws,google}
# output "vars"), at the modules' defaults: the GitHub App's org URL, no
# runner group, both architectures elected with the default sizing, and the
# manifests image's own semver range and signing subject. The terraform
# test suites assert the modules emit exactly these keys.
GITHUB_ARC_CONFIG_URL=https://github.com/bitwise-media-group
GITHUB_ARC_RUNNER_GROUP=
GITHUB_ARC_AMD64_ENABLED=true
GITHUB_ARC_AMD64_MAX_RUNNERS=4
GITHUB_ARC_AMD64_CPU=3
GITHUB_ARC_AMD64_MEMORY=10Gi
GITHUB_ARC_ARM64_ENABLED=true
GITHUB_ARC_ARM64_MAX_RUNNERS=4
GITHUB_ARC_ARM64_CPU=3
GITHUB_ARC_ARM64_MEMORY=10Gi
GITHUB_ARC_MANIFESTS_SEMVER="<1.0.0 >=0.1.0"
SIGNED_IDENTITY_GITHUB_ARC_MANIFESTS="^https://github\.com/bitwise-media-group/github-arc-app-manifests/\.github/workflows/publish\.yaml@refs/tags/v.+$"
