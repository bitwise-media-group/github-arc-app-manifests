# The aws-only github-arc-vars keys modules/aws adds: the Karpenter NodePool
# shape per architecture (deploy/aws/resourceset-nodes.yaml), at the
# module's defaults. ABSENT from the google passes, so a google or common
# manifest reaching for one fails strict substitution.
GITHUB_ARC_AMD64_INSTANCE_FAMILIES=m7i,m7a
GITHUB_ARC_AMD64_CAPACITY_TYPES=on-demand
GITHUB_ARC_AMD64_CPU_LIMIT=16
GITHUB_ARC_AMD64_MEMORY_LIMIT=64Gi
GITHUB_ARC_AMD64_MAX_NODES=4
GITHUB_ARC_AMD64_CONSOLIDATE_AFTER=5m
GITHUB_ARC_ARM64_INSTANCE_FAMILIES=m7g,m8g
GITHUB_ARC_ARM64_CAPACITY_TYPES=on-demand
GITHUB_ARC_ARM64_CPU_LIMIT=16
GITHUB_ARC_ARM64_MEMORY_LIMIT=64Gi
GITHUB_ARC_ARM64_MAX_NODES=4
GITHUB_ARC_ARM64_CONSOLIDATE_AFTER=5m
