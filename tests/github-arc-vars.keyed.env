# Sourced ON TOP of the github-arc-vars fixtures for the keyed passes, so
# each tree also renders the other side of every application gate: a
# single-arch election (arm64 off - no linux-arm64 HelmRelease, no
# github-arc-arm64 NodePool), a runner group, and on aws an amd64 pool with
# no instance-family requirement and mixed capacity types.
GITHUB_ARC_RUNNER_GROUP=platform-ci
GITHUB_ARC_ARM64_ENABLED=false
GITHUB_ARC_AMD64_INSTANCE_FAMILIES=
GITHUB_ARC_AMD64_CAPACITY_TYPES=spot,on-demand
